# ==============================================================================
# MediFind - Environment Variables Template
# Copy this file to .env.local for local development.
# For Vercel deployment, configure these in Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Project URL (found in Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous / Publishable Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional alias (supported for backward compatibility)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

